generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TaskImageKind {
  BEFORE
  AFTER
}

/// Colour theme (accent colours and ambient light); independent of light/dark mode.
enum ColorTheme {
  LAVENDER
  OCEAN
  SUNSET
  FOREST
  ROSE
  AURORA
}

enum ReminderChannel {
  EMAIL
  WHATSAPP
}

/// PENDING → SENDING (claimed by the scheduler) → SENT or FAILED; CANCELLED when the
/// task is completed or the channel is switched off.
enum ReminderStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// LIVE = handed to Gmail/Twilio; PREVIEW = channel not set up yet (development only), so the
/// message was recorded here instead of being sent.
enum DeliveryMode {
  LIVE
  PREVIEW
}

enum ReminderType {
  RELATIVE
  CUSTOM
}

enum UserImageKind {
  AVATAR
}

enum HabitFrequency {
  DAILY
  SPECIFIC_DAYS
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String   @db.VarChar(80)
  passwordHash String
  /// Incremented on password change to invalidate existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings   UserSettings?
  images     UserImage[]
  tasks      Task[]
  categories Category[]
  habits     Habit[]
  reminders  Reminder[]
  spotify    SpotifyConnection?
  deliveries DeliveryLog[]
}

/// Every notification the app tried to deliver (reminders and test messages), for the
/// Settings delivery log. Kept for 30 days.
model DeliveryLog {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderId  String?         @db.Uuid
  channel     ReminderChannel
  destination String          @db.VarChar(254)
  subject     String          @db.VarChar(300)
  body        String
  mode        DeliveryMode
  ok          Boolean
  error       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

/// A user's linked Spotify account. Tokens are encrypted at rest (AES-256-GCM).
model SpotifyConnection {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyUserId String   @db.VarChar(255)
  displayName   String?  @db.VarChar(255)
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  scope         String   @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UserSettings {
  userId            String     @id @db.Uuid
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             Theme      @default(SYSTEM)
  colorTheme        ColorTheme @default(LAVENDER)
  /// 0 = Sunday, 1 = Monday
  weekStartsOn      Int        @default(1)
  timezone          String     @default("UTC")
  defaultPriority   Priority   @default(MEDIUM)
  /// Reminder destination; null means the account email.
  notifyEmail       String?    @db.VarChar(254)
  /// WhatsApp number in international format, e.g. +919876543210.
  notifyPhone       String?    @db.VarChar(20)
  emailReminders    Boolean    @default(true)
  whatsappReminders Boolean    @default(false)
  updatedAt         DateTime   @updatedAt
}

/// A user's own images (their profile photo), kept out of User so the bytes are never
/// loaded with the session.
model UserImage {
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      UserImageKind
  /// Detected from the file contents, never taken from the client.
  mimeType  String        @db.VarChar(32)
  data      Bytes
  updatedAt DateTime      @updatedAt

  @@id([userId, kind])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([userId, name])
}

model Task {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The API requires an explicit reassignment before a category can be deleted;
  /// SetNull is only a database-level safety net so tasks are never cascaded away.
  categoryId       String?     @db.Uuid
  category         Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title            String      @db.VarChar(200)
  description      String?
  notes            String?
  /// Calendar dates (no time-of-day / timezone component).
  dueDate          DateTime?   @db.Date
  startDate        DateTime?   @db.Date
  /// Local wall-clock times, "HH:mm".
  startTime        String?     @db.VarChar(5)
  endTime          String?     @db.VarChar(5)
  priority         Priority    @default(MEDIUM)
  status           TaskStatus  @default(TODO)
  tags             String[]    @default([])
  estimatedMinutes Int?
  completedAt      DateTime?
  /// Idempotency key supplied by the client to prevent duplicate creates.
  clientRequestId  String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  images           TaskImage[]
  reminders        Reminder[]

  @@unique([userId, clientRequestId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, categoryId])
  @@index([userId, completedAt])
  @@index([tags], type: Gin)
}

/// Optional pictures on a task: BEFORE is shown while it is open, AFTER once it is completed.
model TaskImage {
  id        String        @id @default(uuid()) @db.Uuid
  taskId    String        @db.Uuid
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      TaskImageKind
  /// Detected from the file contents, never taken from the client.
  mimeType  String        @db.VarChar(32)
  data      Bytes
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([taskId, kind])
}

/// One reminder for a task on one channel. A reminder chosen in the task form becomes a row
/// per enabled channel. `sendAt` is the UTC instant, worked out from the user's timezone.
model Reminder {
  id          String          @id @default(uuid()) @db.Uuid
  taskId      String          @db.Uuid
  task        Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     ReminderChannel
  status      ReminderStatus  @default(PENDING)
  sendAt      DateTime
  /// The user's choice, kept so the time can be recalculated when the due date changes.
  type        ReminderType
  daysBefore  Int?
  localDate   DateTime?       @db.Date
  localTime   String          @db.VarChar(5)
  /// Identifies the choice ("relative:1:08:00"); one row per task, choice and channel.
  specKey     String          @db.VarChar(40)
  attemptedAt DateTime?
  sentAt      DateTime?
  error       String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([taskId, specKey, channel])
  @@index([status, sendAt])
  @@index([userId])
}

model Habit {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String            @db.VarChar(80)
  description String?
  color       String            @db.VarChar(7)
  frequency   HabitFrequency    @default(DAILY)
  /// Days of week (0 = Sunday … 6 = Saturday) when frequency = SPECIFIC_DAYS.
  daysOfWeek  Int[]             @default([])
  /// First scheduled day, in the user's timezone at creation.
  startDate   DateTime          @db.Date
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  completions HabitCompletion[]

  @@unique([userId, name])
  @@index([userId])
}

model HabitCompletion {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @db.Uuid
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}
