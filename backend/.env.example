# Copy this file to backend/.env and fill in real values. Never commit .env.

# Main application database
DATABASE_URL="postgresql://planner:CHANGE_ME@localhost:5432/daily_planner?schema=public"

# Separate database used by the API test-suite (it is wiped between tests).
# The name must contain "test". It is created automatically if the role has CREATEDB.
TEST_DATABASE_URL="postgresql://planner:CHANGE_ME@localhost:5432/daily_planner_test?schema=public"

# Long random string used to sign session tokens (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

PORT=4000
NODE_ENV=development

# Linked from reminder messages.
APP_URL="http://localhost:5173"

# ---- Reminder email (optional) --------------------------------------------
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="you@gmail.com"
SMTP_PASS=""
MAIL_FROM="Routinely <you@gmail.com>"

# ---- Reminder WhatsApp messages via Twilio (optional) ---------------------
# From https://console.twilio.com. For the WhatsApp sandbox the sender is +14155238886,
# and each recipient must first send the sandbox join code to that number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"

# ---- Spotify listening stats (optional) -------------------------------------
# Create an app at https://developer.spotify.com/dashboard (Web API), add this exact
# Redirect URI to it, and add your Spotify account under "User Management".
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:4000/api/spotify/callback"
